# =====================================================================
# Manakizharchi AI v2.0 - Environment Configuration
# Copy to .env and fill optional cloud keys.
# The system runs 100% locally in deterministic mode even with zero keys.
# =====================================================================

# Confidence Threshold for Stage-1 VADER -> Stage-2 Qdrant+LLM Escalation
CONFIDENCE_THRESHOLD=0.68

# In-Memory TTL/LRU Cache Settings
CACHE_MAX_SIZE=2048
CACHE_TTL_SECONDS=3600

# Qdrant Vector Store (:memory:, local folder path, or remote Qdrant URL)
QDRANT_LOCATION=:memory:
QDRANT_API_KEY=

# Embedding Backend: auto | fast | transformer
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Optional Stage-2 Cloud LLM Providers (Groq / Gemini)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=

# Optional LangSmith Telemetry
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=manakizharchi-ai
